{
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/:uid(\\d+)/guilds",
      "destination": "/guilds"
    },
    {
      "source": "/:uid(\\d+)/:gid(\\d+)",
      "destination": "/dashboard"
    },
    {
      "source": "/:uid(\\d+)/:gid(\\d+)/welcomer",
      "destination": "/welcomer"
    },
    {
      "source": "/:uid(\\d+)/:gid(\\d+)/joinroles",
      "destination": "/joinroles"
    },
    {
      "source": "/:uid(\\d+)/:gid(\\d+)/moderation",
      "destination": "/moderation"
    }
  ],
  "redirects": [
    {
      "source": "/datenschutz",
      "destination": "/privacy-policy",
      "permanent": true
    },
    {
      "source": "/datenschutz.html",
      "destination": "/privacy-policy",
      "permanent": true
    },
    {
      "source": "/nutzungsbedingungen",
      "destination": "/terms-of-service",
      "permanent": true
    },
    {
      "source": "/nutzungsbedingungen.html",
      "destination": "/terms-of-service",
      "permanent": true
    },
    {
      "source": "/impressum",
      "destination": "/legal-notice",
      "permanent": true
    },
    {
      "source": "/impressum.html",
      "destination": "/legal-notice",
      "permanent": true
    }
  ]
}
